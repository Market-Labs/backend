FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build

WORKDIR /src
COPY marketgo-backend/marketgo-backend.csproj marketgo-backend/
RUN dotnet restore marketgo-backend/marketgo-backend.csproj

COPY marketgo-backend/ marketgo-backend/
RUN dotnet publish marketgo-backend/marketgo-backend.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0

WORKDIR /app
COPY --from=build /app/publish .

ENV ASPNETCORE_URLS=http://0.0.0.0:80
EXPOSE 80

ENTRYPOINT ["dotnet", "marketgo-backend.dll"]
